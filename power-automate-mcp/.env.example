# --- Power Automate MCP server configuration ---
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Entra ID (Azure AD) tenant that owns the Power Platform environment.
POWER_AUTOMATE_TENANT_ID=00000000-0000-0000-0000-000000000000

# App registration (service principal) client id.
POWER_AUTOMATE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret. Required for AUTH_MODE=client_credentials; leave blank for device_code.
POWER_AUTOMATE_CLIENT_SECRET=

# Auth mode:
#   client_credentials  -> app-only service principal (headless, default)
#   device_code         -> interactive delegated login (fallback if app-only
#                          access to the Flow API is not granted in your tenant)
POWER_AUTOMATE_AUTH_MODE=client_credentials

# OAuth scope for the Flow management API. Override to the double-slash form
# `https://service.flow.microsoft.com//.default` if you get "invalid audience".
# POWER_AUTOMATE_SCOPE=https://service.flow.microsoft.com/.default

# Optional: default environment name/id so you can omit it on every call.
# Find it by calling the list_environments tool.
# POWER_AUTOMATE_DEFAULT_ENVIRONMENT=

# Optional overrides (defaults shown).
# POWER_AUTOMATE_API_BASE=https://api.flow.microsoft.com
# POWER_AUTOMATE_API_VERSION=2016-11-01
# POWER_AUTOMATE_REQUEST_TIMEOUT=30
